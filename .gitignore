# --- Python ---
.venv/
__pycache__/
*.pyc
.pytest_cache/

# --- Produced pipeline output (regenerated every run; not source) ---
# NOTE: anchor runtime dirs to the repo ROOT with a leading slash, so they do NOT
# also match the CODE package stone_pipeline/state/ (writeback.py, overrides.py).
/outputs/
/state/
/data/
/to_upload/
/review/
/images/
# the sync-ledger DATA file (repo-root /ledger/), NOT the code package
# stone_pipeline/ledger/ (db.py, schema.sql, ...). Leading slash anchors to root.
/ledger/
*.ledger
# runtime state/diagnostics that live INSIDE the code package (keep the .py code)
stone_pipeline/state/*.csv
stone_pipeline/state/*.json
stone_pipeline/outputs/
*.parquet
image_pipeline/images/
image_pipeline/to_upload/
image_pipeline/prompts_to_generate.json
*.parquet
*.bak
failures.jsonl

# Large, environment-specific Medusa download — provide/refresh at deploy time
# (lives on S3 at <env>/scraper/from_medusa/; fetched into the task at run time).
# Per-env layout (from_medusa/<env>/) and the legacy flat path both covered.
# (catalog_source/ and from_medusa/**/attributes.csv ARE committed: source of truth.)
from_medusa/variants_export.csv
from_medusa/**/variants_export.csv

# --- OS ---
.DS_Store

# --- Terraform (state, plans, provider cache, and secret tfvars) ---
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
infra/**/terraform.tfvars
infra/**/*.auto.tfvars
