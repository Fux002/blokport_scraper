# ============================================================================
# Scraper runtime environment -- template. Copy to .env and fill for a LOCAL run:
#     cp .env.template .env
# In a DEPLOYMENT you do NOT hand-write these: Terraform injects the identity/
# storage vars into the task definition (from brands/<brand>.tfvars) and the
# secrets come from SSM. This file is the single checklist of every var + what
# it's for, and the way to run the pipeline locally.
#
# Prefix: the code reads SCRAPER_* first, then legacy BLOKPORT_* (an empty value
# counts as unset). Use the SCRAPER_* names below. An empty var is treated as
# unset, so leave a value blank rather than setting it to "".
# ============================================================================

# --- Identity ---------------------------------------------------------------
SCRAPER_ENV=development           # [required] development | production
SCRAPER_BRAND=blokport            # [required in prod] blokport | wudport | calcport
SCRAPER_DOMAIN_PACK=stone         # [default stone] stone | wood | lime  (product type)

# --- Storage (S3) -----------------------------------------------------------
# In prod, OR for any non-blokport brand even in dev, S3_BUCKET is REQUIRED and
# must start with "<brand>-" (the brand<->bucket guard refuses another brand's bucket).
SCRAPER_S3_BUCKET=                # [required except blokport-dev] e.g. blokport-dev-staging-3e58a6
SCRAPER_S3_REGION=eu-west-1       # [default eu-west-1]

# --- Owner ids (Medusa) -----------------------------------------------------
SCRAPER_SALES_CHANNEL_ID=         # [required in prod] Medusa sales channel id
SCRAPER_COMPANY_ID=               # [optional] Medusa resolves by vendor if unset

# --- Images -----------------------------------------------------------------
SCRAPER_IMAGE_MODE=passthrough    # passthrough | s3  (s3 = download, host to improved/, fill manifest)
SCRAPER_IMAGE_PROCESSING=         # [optional] enable CPU/GPU image processing path

# --- Secrets (in a deploy these come from SSM, NOT this file) ----------------
SCRAPER_SYNC_TOKEN=               # [required for the sync ledger server] bearer token
SCRAPER_CONFIG_TOKEN=             # [required for the config admin server] bearer token
FAL_KEY=                          # [required for de-watermark] FAL FLUX hosted API key
BLOKPORT_SCRAPER_PROXY=           # [optional] residential proxy URL for per-product fetches

# --- Optional overrides (sane defaults if unset) ----------------------------
SCRAPER_CONFIG_DB=                # path to config.db (control plane); default per settings
# BLOKPORT_LEDGER_PATH, BLOKPORT_RUN_MODE, BLOKPORT_ESRGAN_* etc. exist for tuning
# and are documented in stone_pipeline/config/settings.py -- leave unset normally.
